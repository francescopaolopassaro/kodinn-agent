  <metadata>
    <id>kodinncli</id>
    <version>0.9.6</version>
    <title>Kodinn Agent (KodinnCli)</title>
    <authors>Passaro Francesco Paolo</authors>
    <owners>Passaro Francesco Paolo</owners>
    <projectUrl>https://github.com/francescopaolopassaro/kodinn-agent</projectUrl>
    <packageSourceUrl>https://github.com/francescopaolopassaro/kodinn-agent/tree/main/packaging/chocolatey</packageSourceUrl>
    <docsUrl>https://github.com/francescopaolopassaro/kodinn-agent/blob/main/docs/COMMANDS.md</docsUrl>
